QWidget[main_widget=true]
{
    background: rgba(21, 21, 32, 1);
}
QWidget[pannel_widget=true]
{
    background: rgba(34, 34, 50, 0.8);
    border-radius: 0px 0px 4px 4px;
}


QLabel[label_16_bold=true]
{
    color: #FFFFFFFF;
    font-size: 16px;
    font-weight: bold;
}
QLabel[label_15_bold=true]
{
    color: #FFFFFFFF;
    font-size: 15px;
    font-weight: bold;
}
QLabel[label_15_medium=true]
{
    color: #FFFFFFFF;
    font-size: 15px;
    font-weight: medium;
}
QLabel[label_14_medium=true]
{
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
}
QLabel[label_12_medium=true]
{
    color: #FFFFFFFF;
    font-size: 12px;
    font-weight: medium;
}

QPushButton[scene_btn=true]
{
    background: transparent;
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    border: none;
}
QPushButton[scene_btn=true]:hover
{
    background: rgba(124, 124, 164, 1);
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    border-radius: 4px;
}
QPushButton[scene_btn=true]:checked
{
    background: rgba(62, 62, 82, 1);
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    border-radius: 4px;
}


QListWidget
{
    background: transparent;
    color: #FFFFFFFF;
    font-weight: medium;
    border: none;
}
QListWidget::item
{
    background: transparent;
    width: 250px;
    min-height: 34px;
    max-height: 34px; 
    border: none;
    outline: none;
}
QListWidget::item:hover
{
    background: rgba(124, 124, 164, 1);
    border: 1px solid rgba(105, 106, 139, 1);
    border-radius: 5px;
    outline: none;
}
QListWidget::item:selected
{
    background: rgba(62, 62, 82, 1);
    border: 1px solid #696A8B;
    border-radius: 5px;
    outline: none;
}

/* 配置页面导航列表样式 */
QListWidget[config_nav_list=true]
{
    background: transparent;
    border: none;
    outline: none;
}
QListWidget[config_nav_list=true]::item
{
    background: transparent;
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    text-align: center;
    border: none;
    border-radius: 5px;
    min-height: 34px;
    max-height: 34px;
    min-width: 110px;
    max-width: 110px;
}
QListWidget[config_nav_list=true]::item:hover
{
    background: #454558;
}
QListWidget[config_nav_list=true]::item:selected
{
    background: #5370FF;
}
QListWidget[config_nav_list=true]::item:selected:hover
{
    background: #5370FF;
}


/* QSlider 通用样式 */
QSlider {
    height: 18px;
    margin-top: 2px;
    margin-bottom: 2px;
}
QSlider::groove:horizontal
{
    background-color: #526FFD;
    height: 6px;
    border-radius: 3px;
}
QSlider::sub-page:horizontal
{
    background-color: #526FFD;
    border-radius: 3px;
}
QSlider::add-page:horizontal
{
    background-color: #3F4155;
    border-radius: 3px;
}
QSlider::handle:horizontal
{
    background-color: #EEEFFF;
    width: 14px;
    height: 14px;
    margin: -4px 0px;
    border-radius: 7px;
}


/* QGroupBox 通用样式 */
QGroupBox
{
    background-color: transparent;
    border: none;
    padding-top: 16px;
}
QGroupBox::title
{
    background-color: transparent;
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    subcontrol-origin: padding;
    subcontrol-position: top left;
    padding: 0px;
    margin: 0px;
}


/* QMenu 通用样式 */
QMenu
{
    background-color: #222232;
    border: 1px solid #424260;
    border-radius: 5px;
    padding: 4px;
}
QMenu::item
{
    background-color: transparent;
    color: #BBBDDB;
    padding: 10px 6px 10px 6px;
    border: none;
    font-size: 14px;
    font-weight: medium;
    max-height: 30px;
}
QMenu::item:selected
{
    background-color: #393950;
    border: none;
    border-radius: 3px;
}
QMenu::item[delete_action=true]
{
    color: #FF6060;
}
QMenu::separator
{
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
}