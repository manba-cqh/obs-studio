QWidget[main_widget=true]
{
    background: rgba(21, 21, 32, 1);
}

QMainWindow::separator
{ 
    width: 14px;
    height: 14px;
    background: transparent;
}
QMainWindow::separator:hover
{
    background: transparent;
}

QLabel[label_16_bold=true]
{
    color: #FFFFFFFF;
    font-size: 16px;
    font-weight: bold;
}
QLabel[label_15_bold=true]
{
    color: #FFFFFFFF;
    font-size: 15px;
    font-weight: bold;
}
QLabel[label_15_medium=true]
{
    color: #FFFFFFFF;
    font-size: 15px;
    font-weight: medium;
}
QLabel[label_14_medium=true]
{
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
}
QLabel[label_12_medium=true]
{
    color: #FFFFFFFF;
    font-size: 12px;
    font-weight: medium;
}

QPushButton[scene_btn=true]
{
    background: transparent;
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    border: none;
}
QPushButton[scene_btn=true]:hover
{
    background: rgba(124, 124, 164, 1);
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    border-radius: 4px;
}
QPushButton[scene_btn=true]:checked
{
    background: rgba(62, 62, 82, 1);
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    border-radius: 4px;
}

/* 路径选择按钮样式（如保存位置“选择”按钮） */
QPushButton#savePathButton {
    background-color: #3C3C4D;
    color: #EEEEFF;
    border: 1px solid #454558;
    border-radius: 4px;
    font-size: 14px;
    font-weight: medium;
    min-height: 28px;
}
QPushButton#savePathButton:hover {
    background-color: #5370FF;
    border: 1px solid #5370FF;
}
QPushButton#savePathButton:pressed {
    background-color: #4558CC;
}


QListWidget
{
    background: transparent;
    color: #FFFFFFFF;
    font-weight: medium;
    border: none;
}
QListWidget::item
{
    background: transparent;
    width: 250px;
    min-height: 34px;
    max-height: 34px; 
    border: none;
    outline: none;
}
QListWidget::item:hover
{
    background: rgba(124, 124, 164, 1);
    border: 1px solid rgba(105, 106, 139, 1);
    border-radius: 5px;
    outline: none;
}
QListWidget::item:selected
{
    background: rgba(62, 62, 82, 1);
    border: 1px solid #696A8B;
    border-radius: 5px;
    outline: none;
}

/* 配置页面导航列表样式 */
QListWidget[config_nav_list=true]
{
    background: transparent;
    border: none;
    outline: none;
}
QListWidget[config_nav_list=true]::item
{
    background: transparent;
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    text-align: center;
    border: none;
    border-radius: 5px;
    min-height: 34px;
    max-height: 34px;
    min-width: 110px;
    max-width: 110px;
}
QListWidget[config_nav_list=true]::item:hover
{
    background: #454558;
}
QListWidget[config_nav_list=true]::item:selected
{
    background: #5370FF;
}
QListWidget[config_nav_list=true]::item:selected:hover
{
    background: #5370FF;
}


/* ===== SpinBox 主体 ===== */
QSpinBox,
QDoubleSpinBox {
    background-color: #454558;
    color: #FFFFFF;
    border: 1px solid #454558;
    border-radius: 5px;
    padding: 6px 28px 6px 10px;   /* ← 关键：右侧必须留空间给按钮 */
    font-size: 14px;
}
/* hover / focus 边框 */
QSpinBox:hover,
QDoubleSpinBox:hover,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #5370FF;
}
/* ===== 内部输入框必须透明 ===== */
QSpinBox QLineEdit,
QDoubleSpinBox QLineEdit {
    background: transparent;   /* ← 不能再自己画背景 */
    border: none;
    color: #FFFFFF;
}
/* ===== 按钮布局（核心修复点）===== */
QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: padding;        /* ← 必须改成 padding */
    width: 18px;                       /* ← 必须固定宽度 */
    border: none;
    background-color: #454558;
}
/* 上按钮位置 */
QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    margin: 0;
}
/* 下按钮位置 */
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    margin: 0;
}
/* hover 高亮 */
QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background: #5370FF;
    border-radius: 0;
}
/* 箭头 */
QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/images/drop_up.svg);
    width: 14px;
    height: 12px;
}
QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/images/drop_down.svg);
    width: 14px;
    height: 12px;
}

/* QSlider 通用样式 */
QSlider {
    height: 18px;
    margin-top: 2px;
    margin-bottom: 2px;
}
QSlider::groove:horizontal
{
    background-color: #526FFD;
    height: 6px;
    border-radius: 3px;
}
QSlider::sub-page:horizontal
{
    background-color: #526FFD;
    border-radius: 3px;
}
QSlider::add-page:horizontal
{
    background-color: #3F4155;
    border-radius: 3px;
}
QSlider::handle:horizontal
{
    background-color: #EEEFFF;
    width: 14px;
    height: 14px;
    margin: -4px 0px;
    border-radius: 7px;
}


/* QGroupBox 通用样式 */
QGroupBox
{
    background-color: transparent;
    border: none;
    padding-top: 16px;
}
QGroupBox::title
{
    background-color: transparent;
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    subcontrol-origin: padding;
    subcontrol-position: top left;
    padding: 0px;
    margin: 0px;
}


/* QMenu 通用样式 */
QMenu
{
    background-color: #222232;
    border: 1px solid #424260;
    border-radius: 5px;
    padding: 4px;
}
QMenu::item
{
    background-color: transparent;
    color: #BBBDDB;
    padding: 10px 6px 10px 6px;
    border: none;
    font-size: 14px;
    font-weight: medium;
    max-height: 30px;
}
QMenu::item:selected
{
    background-color: #393950;
    border: none;
    border-radius: 3px;
}
QMenu::item[delete_action=true]
{
    color: #FF6060;
}
QMenu::separator
{
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
}

/* QCheckBox 通用样式 */
QCheckBox {
    spacing: 5px;
    color: #EEEEFF;
    font-size: 14px;
    font-weight: medium;
    background: transparent;
    border: none;
}
QCheckBox::indicator:checked {
    background: transparent;
    border: none;
    image: url(:/images/checked.png);
}
QCheckBox::indicator:unchecked {
    background: transparent;
    border: none;
    image: url(:/images/unchecked.png);
}

/* QRadioButton 通用样式（与 QCheckBox 相同的图片） */
QRadioButton {
    spacing: 5px;
    color: #EEEEFF;
    font-size: 14px;
    font-weight: medium;
    background: transparent;
    border: none;
}
QRadioButton::indicator:checked {
    background: transparent;
    border: none;
    image: url(:/images/radio_checked.svg);
}
QRadioButton::indicator:unchecked {
    background: transparent;
    border: none;
    image: url(:/images/radio_unchecked.svg);
}

/* QCheckBox 开关样式 */
QCheckBox[switch_mode = true] {
    spacing: 5px;
    color: #EEEEFF;
    font-size: 14px;
    font-weight: medium;
    background: transparent;
    border: none;
}
QCheckBox[switch_mode = true]::indicator:checked {
    background: transparent;
    border: none;
    image: url(:/images/switch_open.svg);
}
QCheckBox[switch_mode = true]::indicator:unchecked {
    background: transparent;
    border: none;
    image: url(:/images/switch_close.svg);
}

/* CollapsibleGroupBox 折叠/展开组样式 */
QFrame#collapsibleGroupBoxHeader {
    background: transparent;
    border: none;
}
QFrame#collapsibleGroupBoxHeader:hover {
    background: rgba(255, 255, 255, 0.05);
}

/* QMessageBox 全局样式 */
QMessageBox
{
    background-color: #1F1F2C;
    color: #EEEEFF;
    border: none;
}
QMessageBox QLabel
{
    background-color: transparent;
    color: #EEEEFF;
    font-size: 14px;
    font-weight: medium;
}
QMessageBox QPushButton
{
    background-color: #3C3C4D;
    color: #FFFFFFFF;
    border: none;
    border-radius: 5px;
    font-size: 14px;
    font-weight: medium;
    padding: 8px 24px;
    min-width: 80px;
    min-height: 32px;
}
QMessageBox QPushButton:hover
{
    background-color: #5370FF;
}
QMessageBox QPushButton:pressed
{
    background-color: #5370FF;
}
QMessageBox QPushButton:default
{
    background-color: #5370FF;
    color: #FFFFFFFF;
}
QMessageBox QPushButton:default:hover
{
    background-color: #5370FF;
}
QMessageBox QPushButton:default:pressed
{
    background-color: #5370FF;
}
QMessageBox QPushButton:disabled
{
    background-color: #3C3C4D;
    color: #666666;
}
QMessageBox QCheckBox
{
    color: #EEEEFF;
    font-size: 14px;
    font-weight: medium;
    spacing: 8px;
}
QMessageBox QCheckBox::indicator
{
    width: 18px;
    height: 18px;
    border: 1px solid #454558;
    border-radius: 3px;
    background-color: #3C3C4D;
}
QMessageBox QCheckBox::indicator:hover
{
    border: 1px solid #5370FF;
    background-color: #454558;
}
QMessageBox QCheckBox::indicator:checked
{
    background-color: #5370FF;
    border: 1px solid #5370FF;
}
QMessageBox QCheckBox::indicator:checked:hover
{
    background-color: #6B85FF;
    border: 1px solid #6B85FF;
}

/* QToolBar 通用样式 */
QToolBar
{
    background: transparent;
    border: none;
    spacing: 0px;
    padding: 0px;
}
QToolBar::handle
{
    width: 0px;
    image: none;
}
QToolBar::separator
{
    background: transparent;
    width: 0px;
    margin: 0px;
}

/* QScrollBar 全局样式 */
QScrollBar:vertical {
    background: transparent;
    width: 4px;
    border: none;
    border-radius: 2px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgba(125, 125, 154, 0.3);
    border-radius: 2px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(125, 125, 154, 0.5);
}
QScrollBar::handle:vertical:pressed {
    background: rgba(125, 125, 154, 0.7);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 4px;
    border: none;
    border-radius: 2px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: rgba(125, 125, 154, 0.3);
    border-radius: 2px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(125, 125, 154, 0.5);
}
QScrollBar::handle:horizontal:pressed {
    background: rgba(125, 125, 154, 0.7);
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: transparent;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}