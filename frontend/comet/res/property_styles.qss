OBSBasicProperties:scope {
    background-color: transparent;
    color: #FFFFFFFF;
    border-radius: 5px;
}

/* MovableWidget 标题栏样式 */
OBSBasicProperties MovableWidget {
    background-color: #2C2C3C;
    border-radius: 5px 5px 0px 0px;
}

OBSBasicProperties QCheckBox {
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
    spacing: 8px;
}

OBSBasicProperties QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #454558;
    border-radius: 3px;
    background-color: #3C3C4D;
}

OBSBasicProperties QCheckBox::indicator:hover {
    border: 1px solid #5370FF;
    background-color: #454558;
}

OBSBasicProperties QCheckBox::indicator:checked {
    background-color: #5370FF;
    border: 1px solid #5370FF;
}

OBSBasicProperties QCheckBox::indicator:checked:hover {
    background-color: #6B85FF;
    border: 1px solid #6B85FF;
}

OBSBasicProperties QFrame {
    background-color: #2C2C3C;
    border: none;
}

OBSBasicProperties QLabel {
    color: #FFFFFFFF;
    font-size: 14px;
    font-weight: medium;
}

OBSBasicProperties QSpinBox,
OBSBasicProperties QDoubleSpinBox {
    background-color: #3C3C4D;
    color: #FFFFFFFF;
    border: 1px solid #454558;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
    min-height: 28px;
}

OBSBasicProperties QSpinBox:hover,
OBSBasicProperties QDoubleSpinBox:hover {
    border: 1px solid #5370FF;
}

OBSBasicProperties QSpinBox:focus,
OBSBasicProperties QDoubleSpinBox:focus {
    border: 1px solid #5370FF;
    outline: none;
}

OBSBasicProperties QTextEdit,
OBSBasicProperties QPlainTextEdit {
    background-color: #3C3C4D;
    color: #FFFFFFFF;
    border: 1px solid #454558;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
}

OBSBasicProperties QTextEdit:hover,
OBSBasicProperties QPlainTextEdit:hover {
    border: 1px solid #5370FF;
}

OBSBasicProperties QTextEdit:focus,
OBSBasicProperties QPlainTextEdit:focus {
    border: 1px solid #5370FF;
    outline: none;
}

/* QScrollArea 滚动区域样式 */
OBSBasicProperties QScrollArea {
    background-color: transparent;
    border: none;
}

OBSBasicProperties QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* QScrollBar 滚动条样式 */
OBSBasicProperties QScrollBar {
    background-color: #2C2C3C;
    border: none;
    border-radius: 4px;
    margin: 0px;
}

OBSBasicProperties QScrollBar:vertical {
    width: 12px;
}

OBSBasicProperties QScrollBar:horizontal {
    height: 12px;
}

OBSBasicProperties QScrollBar::handle {
    background-color: #454558;
    border-radius: 6px;
    min-height: 20px;
    min-width: 20px;
    margin: 2px;
}

OBSBasicProperties QScrollBar::handle:hover {
    background-color: #5370FF;
}

OBSBasicProperties QScrollBar::handle:pressed {
    background-color: #4260E6;
}

OBSBasicProperties QScrollBar::add-line,
OBSBasicProperties QScrollBar::sub-line {
    border: none;
    background: none;
    height: 0px;
    width: 0px;
}

OBSBasicProperties QScrollBar::add-page,
OBSBasicProperties QScrollBar::sub-page {
    background: none;
}

OBSBasicProperties QScrollBar::up-arrow,
OBSBasicProperties QScrollBar::down-arrow,
OBSBasicProperties QScrollBar::left-arrow,
OBSBasicProperties QScrollBar::right-arrow {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}